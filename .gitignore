# Python
__pycache__/
*.py[cod]
venv/
*.egg-info/

# Training artifacts
training/checkpoints/
training/prepared/
*.onnx

# Misc
.DS_Store
.env
.env.local

# Editor directories and files
.idea
.vscode
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# MCP config secrets (API keys via env var, never committed)
.mcp.local.json

# Session handoffs — local-only, overwritten each session, not part of project history
/training/Session Handoffs/

# Review bridge handoff files — local-only, overwritten each review cycle,
# not part of project history (same rationale as Session Handoffs above)
/review_bridge/

# Real, hand-written personal notes -- the pre-conversion draft that becomes
# datasets/real_validation.jsonl, which is gitignored for the same reason
# via datasets/.gitignore: uncontaminated real notes, never meant to be
# published alongside the code (DATASET_SPEC.md's real tier). This file is
# the same private category, just upstream of the conversion. External
# review, 2026-09-02.
/training/Real Examples for Human Input.txt

# Local run logs -- not source, not reviewed docs, regenerated on every run.
/training/*_run_*.log
/training/*_run.log

# Derived from a tracked .md review doc via a scratchpad conversion script,
# not source itself -- regeneratable from the .md, not meaningfully
# diffable as a binary. Kept on disk for local reading, not tracked.
/docs/reviews/*.docx

